# ============================================================
#  Environment variables template — copy to .env and fill in.
#  Do NOT commit the real .env (it is git-ignored).
# ============================================================

# --- Client (safe to expose, injected at build time) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# --- Server only (used by server functions / API routes) ---
# Required for image serving (/api/public/media) and public SSR reads.
# The image proxy uses ONLY the publishable (anon) key, so images work on
# any host (Vercel, etc.) without the service-role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Optional: only needed for privileged admin/maintenance operations that
# bypass RLS. NOT required for serving images. On Lovable Cloud this value is
# managed for you and is not retrievable for external hosts.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
